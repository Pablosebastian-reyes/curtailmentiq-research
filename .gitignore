# Datos pesados: se versionan los checksums, no los binarios grandes.
# Si el equipo decide versionar data-raw completo, usar Git LFS y borrar estas líneas.
data-raw/*.csv
data-raw/*.xlsx
data-raw/*.zip
data-raw/*.parquet
!data-raw/CHECKSUMS.sha256
!data-raw/README.md

# Credenciales y entorno
.env
*.env
__pycache__/
.ipynb_checkpoints/
*.pyc
.DS_Store

# Release: se versionan diccionario, errata_log.csv y CHECKSUMS; los datos van a Zenodo.
release/**/*.parquet
release/**/curtailment_*.csv
release/**/plants*.csv

# Compilacion LaTeX: se versionan los PDF finales, no los auxiliares.
build/*.aux
build/*.log
build/*.out
build/*.toc
build/*.synctex.gz

# entrega_revision/ son copias de archivos que ya estan en el repo,
# armadas para compartir. No se versionan.
entrega_revision/
build/*.spl
